<?xml version="1.0"?>
<sdf version="1.9">
  <world name="warehouse">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <gravity>0 0 -9.81</gravity>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.4 -0.5 -1</direction></light>
    <model name="floor"><static>true</static><link name="floor_link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></visual></link></model>
    <model name="shelf"><static>true</static><pose>2 0 0.5 0 0 0</pose><link name="shelf_link"><collision name="collision"><geometry><box><size>0.6 2 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.6 2 1</size></box></geometry><material><diffuse>0.8 0.45 0.1 1</diffuse></material></visual></link></model>
    <include><uri>model://autonav_robot</uri><name>autonav_robot</name></include>
  </world>
</sdf>
